{
  "name": "who-told-who",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --hot index.html debug.html --port=5173",
    "build": "sh -c 'rm -rf dist && bun run build:data && bun run build:bundle'",
    "build:data": "bun run scripts/build_daily_json.mjs",
    "build:bundle": "bun build ./index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\\\"production\\\"' --env='BUN_PUBLIC_*'",
    "typecheck": "tsc --noEmit",
    "test:web": "bun test src",
    "test:e2e": "playwright test",
    "preview": "bun --serve dist/index.html --port=4173",
    "check:web": "bun run typecheck && bun run test:web && bun run build"
  },
  "dependencies": {
    "i18next": "^25.8.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/react": "^18.3.7",
    "@types/react-dom": "^18.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.6.3"
  }
}
