{
  "name": "who-told-who",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --hot index.html debug.html preview.html --port=5173",
    "build": "sh -c 'rm -rf dist && bun run build:bundle && mkdir -p dist/static && cp -f static/preview.webp dist/static/preview.webp'",
    "build:bundle": "bun build ./index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\\\"production\\\"' --env='BUN_PUBLIC_*'",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "test:e2e": "playwright test",
    "preview": "bun --serve dist/index.html --port=4173",
    "serve:dist": "bun run build && bun run preview",
    "check": "bun run build && bun run typecheck && bun run test && bun run test:e2e"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "i18next": "^25.8.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.9",
    "@types/jsdom": "^27.0.0",
    "@types/react": "^18.3.7",
    "@types/react-dom": "^18.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "jsdom": "^28.1.0",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.6.3"
  }
}
