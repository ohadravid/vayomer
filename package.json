{
  "name": "who-told-who",
  "private": true,
  "version": "0.9.1",
  "type": "module",
  "scripts": {
    "prepare:quotes": "node scripts/prepare_quote_assets.ts",
    "predev": "npm run prepare:quotes",
    "dev": "vite --port=5173",
    "prebuild": "npm run prepare:quotes",
    "build": "sh -c 'rm -rf dist && vite build'",
    "pretypecheck": "npm run prepare:quotes",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run prepare:quotes",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "preview": "vite preview --port=4173",
    "serve:dist": "npm run build && npm run preview",
    "check": "npm run build && npm run typecheck && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "i18next": "^25.8.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^27.0.0",
    "@types/react": "^18.3.7",
    "@types/react-dom": "^18.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^28.1.0",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.6.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
